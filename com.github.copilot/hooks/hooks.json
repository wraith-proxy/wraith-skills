{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\" copilot || true",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\" copilot || true",
        "matcher": "bash|powershell",
        "timeoutSec": 10
      }
    ]
  }
}
